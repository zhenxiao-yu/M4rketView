# M4rketView — Environment Variables
# ─────────────────────────────────────
# This app uses ONLY free public APIs that require NO API keys.
# No .env file is needed to run locally or to deploy.
#
# Build-time constants are injected automatically by vite.config.ts:
#   __APP_VERSION__  — from package.json "version"
#   __BUILD_TIME__   — ISO timestamp at build time
#   __GIT_SHA__      — from VERCEL_GIT_COMMIT_SHA (Vercel) or GITHUB_SHA (CI)
#
# If you want to override the displayed commit SHA in local dev, you can set:
# GITHUB_SHA=my-local-build
